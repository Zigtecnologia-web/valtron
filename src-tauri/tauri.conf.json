{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valtron",
  "version": "0.1.4",
  "identifier": "com.valtron.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Valtron",
        "width": 1100,
        "height": 720,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwOUJBOUQyOUQwN0IwQjQKUldTMHNBZWQwcW1iTURWMVNSRVBZNXBIOFh0d3paNm9BZHNSY2RkcktEdURaZGVUQjFXSEZ2b3YK",
      "endpoints": [
        "https://github.com/Zigtecnologia-web/valtron/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
